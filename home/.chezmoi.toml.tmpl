{{- $colorScheme := promptStringOnce . "color.scheme" "color scheme" "moonlight" -}}
{{- $colorSpecial := promptStringOnce . "color.special" "special color" "orange" -}}
{{- $dimensionBorder := promptIntOnce . "dimension.border" "border (px)" 2 -}}
{{- $dimensionGap := promptIntOnce . "dimension.gap" "gap (px)" 48 -}}
{{- $dimensionPadding := promptIntOnce . "dimension.padding" "padding (px)" 8 -}}
{{- $editor := promptStringOnce . "editor" "editor" "vi" -}}
{{- $fontName := promptStringOnce . "font.name" "font name" "monospace" -}}
{{- $fontSize := promptIntOnce . "font.size" "font size (pt)" 11 -}}
{{- $gitEmail := promptStringOnce . "git.email" "git email" -}}
{{- $gitName := promptStringOnce . "git.name" "git author name" -}}
{{- $obsidianBackupDir := promptStringOnce . "obsidian.backupDir" "Obsidian backup directory (absolute path)" "" -}}
{{- $obsidianVaultDir := promptStringOnce . "obsidian.vaultDir" "Obsidian vault directory (absolute path)" "" -}}
{{- $shell := promptStringOnce . "shell" "shell" "bash" -}}
{{- $umask := promptStringOnce . "umask" "umask" "022" | trunc -3 -}}

format = "json"
mode = "file"
umask = 0o{{- $umask }}

[data]
editor = {{ $editor | quote }}
shell = {{ $shell | quote }}
umask = {{ printf "0%s" $umask | quote }}

[data.color]
scheme = {{ $colorScheme | quote }}
special = {{ $colorSpecial | quote }}

[data.dimension]
border = {{ $dimensionBorder }}
gap = {{ $dimensionGap }}
padding = {{ $dimensionPadding }}

[data.font]
name = {{ $fontName | quote }}
size = {{ $fontSize }}

[data.git]
email = {{ $gitEmail | quote }}
name = {{ $gitName | quote }}

[data.obsidian]
backupDir = {{ $obsidianBackupDir | quote }}
enabled = {{ or (ne $obsidianBackupDir "") (ne $obsidianVaultDir "") }}
vaultDir = {{ $obsidianVaultDir | quote }}
