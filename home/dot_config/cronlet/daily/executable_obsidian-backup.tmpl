#!/bin/sh
#
# Zip the contents of my Obsidian vault and move the archive to a backup location
# (e.g., synced cloud storage directory).

set -eu

VAULT_DIR={{- joinPath .chezmoi.destDir .directory.obsidianVault | quote }}
BACKUP_DIR={{- joinPath .chezmoi.destDir .directory.backup | quote }}
HOSTNAME="$(uname -n)"
ZIP_NAME="$(date -u '+%Y-%m-%dT%H%M%S')--$(basename "$VAULT_DIR")--$HOSTNAME.zip"
TMP_DIR=${TMPDIR:-/tmp}
TMP_ZIP="$TMP_DIR/$ZIP_NAME.$$.tmp"
FINAL_ZIP="$BACKUP_DIR/$ZIP_NAME"

log() {
    echo "$(date -u '+%Y-%m-%dT%H:%M:%S') $HOSTNAME: $*" >&2
}

if [ ! -d "$VAULT_DIR" ]; then
    log "ERROR: Source directory '$VAULT_DIR' not found."
    exit 1
fi

if [ ! -d "$BACKUP_DIR" ]; then
    log "ERROR: Backup directory '$BACKUP_DIR' does not exist."
    exit 1
fi

if [ ! -x "$(command -v zip)" ]; then
    log "ERROR: 'zip' not found in PATH."
    exit 1
fi

if [ -e "$FINAL_ZIP" ]; then
    log "ERROR: Destination file '$FINAL_ZIP' already exists."
    exit 1
fi

trap 'rm -f "$TMP_ZIP"' EXIT HUP INT TERM

log "Archiving: '$VAULT_DIR'."
(cd "$VAULT_DIR" && zip -qr "$TMP_ZIP" . -x '**/.DS_Store')
SIZE="$(du -h "$TMP_ZIP" | cut -f1)"
log "Created archive: $ZIP_NAME ($SIZE)."
log "Copying to: $BACKUP_DIR."
cp "$TMP_ZIP" "$FINAL_ZIP"
log "OK: Backup complete: $FINAL_ZIP."
